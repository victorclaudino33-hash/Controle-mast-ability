rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }
    function meuUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function minhaBase() {
      return meuUsuario().base;
    }
    function souAdmin() {
      return logado() && meuUsuario().isAdmin == true;
    }

    // Cada login só lê o próprio perfil; admin lê todos.
    // A criação/edição de usuários é feita manualmente pelo Console (ver README).
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || souAdmin());
      allow write: if false;
    }

    // Metas de prazo, feriados e lista de bases. Só o admin edita.
    match /config/{doc} {
      allow read: if logado();
      allow write: if souAdmin();
    }

    // Cada base só lê e grava os próprios registros. Admin lê e grava tudo.
    match /registros/{id} {
      allow read: if souAdmin() || (logado() && resource.data.base == minhaBase());
      allow create: if souAdmin() || (logado() && request.resource.data.base == minhaBase());
      allow update, delete: if souAdmin() || (logado() && resource.data.base == minhaBase());
    }
  }
}
